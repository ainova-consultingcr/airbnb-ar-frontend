# Primera configuración de cuentas AVI. Use un valor largo y aleatorio.
AVI_SETUP_KEY=

# Credencial técnica compartida con ASADA Monitor. No se expone al navegador.
ASADA_DEMO_SERVICE_KEY=
ASADA_DEMO_API_BASE_URL=https://asada-monitor-api.onrender.com

# Opcional: ubicación de la base SQLite de usuarios AVI.
AVI_ACCESS_DATABASE=backend/data/avi_access.sqlite3

# Opcional: espera máxima para consultar ASADA Monitor.
ASADA_MONITOR_TIMEOUT_SECONDS=60

# Web Push. La privada y la credencial de eventos solo existen en el servidor.
AVI_PUSH_VAPID_PUBLIC_KEY=
AVI_PUSH_VAPID_PRIVATE_KEY=
AVI_PUSH_VAPID_SUBJECT=mailto:admin@example.com
ASADA_EVENT_SERVICE_KEY=
